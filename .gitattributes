# Store text with LF in the repository; check out with each platform's native line endings.
* text=auto

# Files that must keep one line ending everywhere
*.sh   text eol=lf
*.py   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings or try to diff them
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.7z   binary

# engine/ is imported from RBDOOM-3-BFG: keep its files byte-for-byte as upstream has them,
# so upstream changes can be merged cleanly. engine/.gitattributes still applies on top.
engine/** -text
